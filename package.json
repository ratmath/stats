{
  "name": "@ratmath/stats",
  "version": "0.3.0",
  "description": "Probability and statistics for RatMath: exact finite probability, certified distributions, seeded data generation with noise, tests, regression, rank tests, the bootstrap, Markov chains and Bayesian updating",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "probability",
    "statistics",
    "distribution",
    "regression",
    "simulation",
    "exact",
    "ratmath"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/stats.git"
  },
  "homepage": "https://ratmath.com/stats/",
  "bugs": {
    "url": "https://github.com/ratmath/stats/issues"
  },
  "dependencies": {
    "@ratmath/analytic": "^0.1.0",
    "@ratmath/discrete": "^0.3.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.12.0"
  },
  "devDependencies": {
    "@ratmath/core": "^0.12.0",
    "katex": "0.19.1"
  },
  "types": "index.d.ts",
  "author": "James Taylor",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "vendor/analytic",
    "vendor/discrete",
    "vendor/algebraic",
    "vendor/logic"
  ]
}
